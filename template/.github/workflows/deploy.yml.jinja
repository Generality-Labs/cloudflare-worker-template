name: Deploy

{% if use_staging %}
# Every push to main deploys staging, then production. Add required reviewers
# to the `production` GitHub environment (repo settings) to make the
# staging -> production hand-off a manual approval gate — note this needs
# GitHub Team+ (or a public repo); on the Free plan for private repos the
# environment exists but reviewers can't be required. Each job smoke-tests
# the Worker afterwards when a HEALTH_URL variable is set on its GitHub
# environment.
{% else %}
# Every push to main deploys production. The job smoke-tests the Worker
# afterwards when a HEALTH_URL variable is set on the `production` GitHub
# environment.
{% endif %}
#
# Requires two repository secrets (see README.md):
#   CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID
# and, only when HEALTH_URL sits behind Cloudflare Access, the optional
#   ACCESS_CLIENT_ID, ACCESS_CLIENT_SECRET  (an Access service token)
on:
  push:
    branches:
      - main
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: deploy
  cancel-in-progress: false # never abandon a half-done deploy

jobs:
{% if use_staging %}
  staging:
    uses: {{ github_owner }}/cloudflare-worker-template/.github/workflows/worker-deploy.yml@v1
    with:
      environment: staging
      deploy-script: deploy:staging
      {% if use_d1 %}
      migrations-script: migrations:staging
      {% endif %}
      node-version: "{{ node_version }}"
    secrets:
      cloudflare-api-token: ${{ '{{' }} secrets.CLOUDFLARE_API_TOKEN {{ '}}' }}
      cloudflare-account-id: ${{ '{{' }} secrets.CLOUDFLARE_ACCOUNT_ID {{ '}}' }}
      access-client-id: ${{ '{{' }} secrets.ACCESS_CLIENT_ID {{ '}}' }}
      access-client-secret: ${{ '{{' }} secrets.ACCESS_CLIENT_SECRET {{ '}}' }}

  # Optional: a real end-to-end gate between staging and production — a job
  # that exercises the DEPLOYED staging Worker and blocks production when it
  # fails (see README "Gating production on staging"). To enable: uncomment,
  # write scripts/e2e-check.sh, and change production's `needs:` to e2e-gate.
  # Uniquify anything the check creates with RUN_TAG — a retried run must not
  # collide with (or be silently deduplicated against) a previous attempt.
  #
  # e2e-gate:
  #   name: E2E gate (staging)
  #   needs: staging
  #   runs-on: ubuntu-latest
  #   environment: staging  # so it can read staging-environment secrets
  #   timeout-minutes: 10
  #   permissions:
  #     contents: read
  #   steps:
  #     - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
  #       with:
  #         persist-credentials: false
  #     - name: Exercise the deployed staging Worker
  #       env:
  #         RUN_TAG: ${{ '{{' }} github.run_id {{ '}}' }}-${{ '{{' }} github.run_attempt {{ '}}' }}
  #       run: bash scripts/e2e-check.sh

  production:
    needs: staging # switch to `needs: e2e-gate` when the gate is enabled
    uses: {{ github_owner }}/cloudflare-worker-template/.github/workflows/worker-deploy.yml@v1
    with:
      environment: production
      deploy-script: deploy
      {% if use_d1 %}
      migrations-script: migrations:prod
      {% endif %}
      node-version: "{{ node_version }}"
    secrets:
      cloudflare-api-token: ${{ '{{' }} secrets.CLOUDFLARE_API_TOKEN {{ '}}' }}
      cloudflare-account-id: ${{ '{{' }} secrets.CLOUDFLARE_ACCOUNT_ID {{ '}}' }}
      access-client-id: ${{ '{{' }} secrets.ACCESS_CLIENT_ID {{ '}}' }}
      access-client-secret: ${{ '{{' }} secrets.ACCESS_CLIENT_SECRET {{ '}}' }}
{% else %}
  production:
    uses: {{ github_owner }}/cloudflare-worker-template/.github/workflows/worker-deploy.yml@v1
    with:
      environment: production
      deploy-script: deploy
      {% if use_d1 %}
      migrations-script: migrations:prod
      {% endif %}
      node-version: "{{ node_version }}"
    secrets:
      cloudflare-api-token: ${{ '{{' }} secrets.CLOUDFLARE_API_TOKEN {{ '}}' }}
      cloudflare-account-id: ${{ '{{' }} secrets.CLOUDFLARE_ACCOUNT_ID {{ '}}' }}
      access-client-id: ${{ '{{' }} secrets.ACCESS_CLIENT_ID {{ '}}' }}
      access-client-secret: ${{ '{{' }} secrets.ACCESS_CLIENT_SECRET {{ '}}' }}
{% endif %}
