{#
  vitest and its override must stay on the same range. npm 10's arborist
  crashes ("Cannot read properties of null (reading 'edgesOut')") on a
  lockfile-less install of vitest >= 4.1: vitest's optional peer @vitest/ui
  pulls @vitejs/devtools-vitest, which peers on `vitest: *`, which resolves
  to the next major, whose own peer set pins that major back -- a peer cycle
  npm 10 mishandles. The override collapses every vitest spec in the tree to
  ours and keeps `npm install` working on the npm that ships with Node 22.
#}
{% set vitest_range = '^4.1.0' %}
{
  "name": "{{ project_name }}",
  "version": "0.1.0",
  "description": "{{ project_description }}",
  "private": true,
  "type": "module",
  {% if license == 'MIT' %}
  "license": "MIT",
  {% else %}
  "license": "UNLICENSED",
  {% endif %}
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "wrangler types --include-runtime=false && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    {% if use_playwright %}
    "test:e2e": "playwright test",
    {% endif %}
    {% if use_staging %}
    "secrets:staging": "bash scripts/put-secrets.sh staging",
    {% endif %}
    "secrets": "bash scripts/put-secrets.sh production",
    {% if use_d1 %}
    "migrations:local": "wrangler d1 migrations apply {{ project_name }}-dev --local",
    {% if use_staging %}
    "migrations:staging": "wrangler d1 migrations apply {{ project_name }}-staging --env staging --remote",
    {% endif %}
    "migrations:prod": "wrangler d1 migrations apply {{ project_name }} --env production --remote",
    {% endif %}
    {% if use_staging %}
    "deploy:staging": "wrangler deploy --env staging",
    {% endif %}
    "deploy": "wrangler deploy --env production",
    "tail": "wrangler tail --env production"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.19.0",
    "@cloudflare/workers-types": "^5.20260722.0",
    {% if use_playwright %}
    "@playwright/test": "^1.62.1",
    {% endif %}
    "typescript": "^5.9.0",
    "vitest": "{{ vitest_range }}",
    "wrangler": "^4.0.0"
  },
  "overrides": {
    "vitest": "{{ vitest_range }}"
  }
}
